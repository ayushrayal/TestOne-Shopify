<style>
  .image-grid-{{ section.id }} {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    padding: 20px;
  }

  .image-card-{{ section.id }} {
    overflow: hidden;
    border-radius: 10px;
    transition: transform 0.3s ease;
  }

  .image-card-{{ section.id }}:hover {
    transform: scale(1.03);
  }

  .image-card-{{ section.id }} img {
    width: 100%;
    {% comment %} height: 500px; {% endcomment %}
    object-fit: cover;
    {% comment %} display: block; {% endcomment %}
    border-radius: 10px;
  }

  .image-title-{{ section.id }} {
    margin-top: 10px;
    font-size: 18px;
    font-weight: 600;
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .image-grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 480px) {
    .image-grid-{{ section.id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="image-grid-{{ section.id }}">

  {% for block in section.blocks %}

    <div class="image-card-{{ section.id }}" {{ block.shopify_attributes }}>

      <a href="{{ block.settings.image_link }}">

        {% if block.settings.image %}

          <img
            src="{{ block.settings.image | image_url: width: 600 }}"
            alt="{{ block.settings.image.alt }}"
            loading="lazy"
            width="600"
            height="600"
          >

        {% else %}

          {{ 'image' | placeholder_svg_tag }}

        {% endif %}

      </a>

      <h3 class="image-title-{{ section.id }}">
        {{ block.settings.title }}
      </h3>

    </div>

  {% endfor %}

</div>

{% schema %}
{
  "name": "Item Collection",

  "blocks": [
    {
      "type": "item",

      "name": "Item",

      "settings": [

        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "New Collection"
        },

        {
          "type": "url",
          "id": "image_link",
          "label": "Image Link"
        }

      ]
    }
  ],

  "presets": [
    {
      "name": "Item Collection"
    }
  ]
}
{% endschema %}