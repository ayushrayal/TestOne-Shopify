<style>
  h1{
  color:"red"}
</style>
<div class="pagewidth">
  <h1>This is a Feedback Form.</h1>
  <h1>{{ section.settings.heading_text }}</h1>
  <p>{{ section.settings.paragraph_text }}</p>
  {% if section.settings.number <= 0 %}
    {{ section.settings.number }}
  {% endif %}
</div>

{% schema %}
{
  "name": "class 1",
  "settings": [
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "Email"
    },
    {
      "type": "textarea",
      "id": "paragraph_text",
      "label": "Paragraph",
      "default": "Feedback"
    },
    {
      "type": "number",
      "id": "number",
      "label": "Number",
      "default": 7251848020
    }
  ],
  "presets": [
    {
      "name": "class 1"
    }
  ],
  "blocks": []
}
{% endschema %}
