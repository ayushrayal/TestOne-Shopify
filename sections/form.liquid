<style>
    h1{
    padding-top:{{ section.settings.Padding_Top }}rem;
    text-align:{{ section.settings.Heading-Alignment }}
  }
</style>
<div class="pagewidth">
  <h1>This is a Feedback Form.</h1>
  <h1>{{ section.settings.heading_text }}</h1>
  <p>{{ section.settings.paragraph_text }}</p>
  {% if section.settings.number >= 0 %}
    {{ section.settings.number }}
  {% endif %}
</div>

{% schema %}
{
  "name": "class 1",
  "settings": [
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "Email"
    },
    {
      "type": "textarea",
      "id": "paragraph_text",
      "label": "Paragraph",
      "default": "Feedback"
    },
    {
      "type": "number",
      "id": "number",
      "label": "Number",
      "default": 7251848020
    },
    {
      "type": "range",
      "label": "Padding-top",
      "id": "Padding_Top",
      "min": 0,
      "max": 100,
      "default": 0,
      "step": 1,
      "unit": "rem"
    },
    {
      "type": "select",
      "id": "Heading-Alignment",
      "label": "Heading-Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left Align"
        },
        {
          "value": "center",
          "label": "Center Align"
        },
        {
          "value": "right",
          "label": "Right Align"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "class 1"
    }
  ],
  "blocks": []
}
{% endschema %}
