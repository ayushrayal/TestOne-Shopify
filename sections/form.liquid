<style>
    h1{
    padding-top:{{ section.settings.padding_top }}rem;
    text-align:{{ section.settings.heading-alignment }}
  }
</style>
<div class="pagewidth">
  <h1>This is a Feedback Form.</h1>
  <h1>{{ section.settings.heading_text }}</h1>
  <p>{{ section.settings.paragraph_text }}</p>
  {% if section.settings.number >= 0 %}
    {{ section.settings.number }}
  {% endif %}
</div>

{% schema %}
{
  "name": "class 1",
  "settings": [
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "Email"
    },
    {
      "type": "textarea",
      "id": "paragraph_text",
      "label": "Paragraph",
      "default": "Feedback"
    },
    {
      "type": "number",
      "id": "number",
      "label": "Number",
      "default": 7251848020
    },
    {
      "type": "range",
      "label": "Padding-top",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "default": 0,
      "step": 1,
      "unit": "rem"
    },
    {
  "type": "select",
  "id": "heading_alignment",
  "label": "Heading Alignment",
  "default": "left",
  "options": [
    {
      "value": "left",
      "label": "Left"
    },
    {
      "value": "center",
      "label": "Center"
    },
    {
      "value": "right",
      "label": "Right"
    }
  ]
}
  ],
  "presets": [
    {
      "name": "class 1"
    }
  ],
  "blocks": []
}
{% endschema %}
